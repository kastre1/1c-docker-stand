# ============================================================
# Git attributes для проекта 1C-Docker-Stand
# ============================================================

# --- Markdown ---
*.md text eol=lf

# --- Конфиги ---
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# --- Dockerfile ---
Dockerfile text eol=lf
*.dockerfile text eol=lf

# --- SQL ---
*.sql text eol=lf

# --- Скрипты Windows ---
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- Бинарные файлы (не менять) ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tar.bz2 binary
*.deb binary
*.run binary

# --- Специальные .gitattributes для лингвистики GitHub ---
*.sh linguist-language=Shell
Dockerfile linguist-language=Dockerfile
*.md linguist-documentation=true
